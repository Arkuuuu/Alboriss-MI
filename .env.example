# ==============================================================================
# Medical Insurance Application - Environment Variables
# For Vercel Deployment & Supabase Cloud Integration
# ==============================================================================

# 1. Supabase Project Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 2. Manager Security Portal Credentials
# Used to authenticate at /manager
MANAGER_USERNAME="manager"
MANAGER_PASSWORD="manager@secure2026"

# 3. Session Security
# A random cryptographic secret used to sign HMAC session tokens
MANAGER_SECRET="replace-with-a-secure-random-32-char-secret-key"

